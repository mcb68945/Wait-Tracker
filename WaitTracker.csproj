<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loader: the only DLL the game loads. Picks WaitTracker.V111.dll or WaitTracker.V113.dll at startup.
       Build all three with ./build.sh. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>WaitTracker</AssemblyName>
    <RootNamespace>WaitTracker</RootNamespace>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Loader.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2"><HintPath>lib/v113/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>lib/v113/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
